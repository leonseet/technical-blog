# If you want to use your Claude subscription instead of an API key, see https://github.com/mattpocock/sandcastle/issues/191
CLAUDE_CODE_OAUTH_TOKEN=

# Issue tracker access for this repository. The loop detects GitLab vs GitHub
# from the `origin` remote: gitlab.com / github.com are recognized directly; a
# self-hosted instance is named via GITLAB_HOST or GH_HOST. Set
# SANDCASTLE_ISSUE_TRACKER to settle it by hand.

# GitHub project access. GH_TOKEN is a token with repo scope.
# GH_TOKEN=
# GH_HOST=github.example.com   # self-hosted GitHub Enterprise only

# GitLab project access, for a repo hosted there instead. GITLAB_TOKEN is a
# project access token with `api` scope.
# GITLAB_TOKEN=
# GITLAB_HOST=gitlab.example.com   # self-hosted GitLab only

# SANDCASTLE_ISSUE_TRACKER=github

# Explainer hosting, used by the finalize stage to publish the run's HTML
# explainer at a permanent URL. Optional: leave EXPLAINER_HOST unset and the
# explainer step degrades without failing the run. `s3` works against any
# S3-compatible store (AWS, Ceph RGW, MinIO, R2).
# EXPLAINER_HOST=s3
# EXPLAINER_S3_ENDPOINT=
# EXPLAINER_S3_BUCKET=
# EXPLAINER_S3_ACCESS_KEY=
# EXPLAINER_S3_SECRET_KEY=
# EXPLAINER_S3_REGION=
# EXPLAINER_S3_CA_BUNDLE=          # CA bundle path for privately-signed endpoints
# EXPLAINER_S3_PUBLIC_BASE_URL=    # override for CDN/virtual-host fronting
